# Drizzle records sha256 of each migration file as read from disk (line endings
# included), and scripts/verify-migration-integrity.ts cross-checks it. Pin
# db/migrations to LF so Windows autocrlf can't rewrite it on checkout.
# This acts only on commit/checkout: a file applied BEFORE it is committed is
# hashed as written, so check-migration-skip also refuses a pending migration
# containing CR (prod 0204/0208 were recorded as CRLF that way, 2026-10-12).
db/migrations/** text eol=lf
